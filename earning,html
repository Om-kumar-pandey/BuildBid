<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Earnings | BuildBid Contractor Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
    }

    button,
    input,
    select {
      font: inherit;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* ================= SIDEBAR ================= */

    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      width: 250px;
      background: #111827;
      color: #fff;
      padding: 22px 14px;
      overflow-y: auto;
      z-index: 100;
    }

    .logo {
      font-size: 23px;
      font-weight: 800;
      padding: 0 14px 25px;
    }

    .logo span {
      color: #f59e0b;
    }

    .nav-title {
      color: #8892a6;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 15px 14px 8px;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border-radius: 9px;
      color: #c8d0dd;
      margin-bottom: 3px;
      font-size: 14px;
      transition: .2s;
    }

    .nav-item:hover {
      background: #1f2937;
      color: #fff;
    }

    .nav-item.active {
      background: #f59e0b;
      color: #111827;
      font-weight: 700;
    }

    .nav-icon {
      width: 21px;
      text-align: center;
    }

    /* ================= MAIN ================= */

    .main {
      margin-left: 250px;
      min-height: 100vh;
    }

    .topbar {
      height: 70px;
      background: #fff;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 30px;
    }

    .page-title {
      font-size: 21px;
      font-weight: 750;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .notification {
      position: relative;
      font-size: 20px;
      cursor: pointer;
    }

    .notification-dot {
      position: absolute;
      right: -3px;
      top: -2px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #ef4444;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #f59e0b;
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #111827;
    }

    .content {
      padding: 30px;
    }

    /* ================= CARDS ================= */

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 24px;
    }

    .stat-card {
      background: #fff;
      border: 1px solid #e7eaf0;
      border-radius: 14px;
      padding: 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }

    .stat-label {
      color: #697386;
      font-size: 13px;
      margin-bottom: 9px;
    }

    .stat-value {
      font-size: 27px;
      font-weight: 800;
      margin-bottom: 7px;
    }

    .stat-change {
      font-size: 12px;
      color: #16a34a;
      font-weight: 600;
    }

    .stat-icon {
      float: right;
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: #fff7e6;
      display: grid;
      place-items: center;
      font-size: 19px;
    }

    /* ================= GRID ================= */

    .grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 22px;
      margin-bottom: 24px;
    }

    .card {
      background: #fff;
      border: 1px solid #e7eaf0;
      border-radius: 14px;
      padding: 22px;
      box-shadow: 0 2px 8px rgba(0,0,0,.03);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .card-title {
      font-size: 17px;
      font-weight: 750;
    }

    .btn {
      border: 0;
      border-radius: 8px;
      padding: 9px 14px;
      cursor: pointer;
      font-weight: 650;
      font-size: 13px;
    }

    .btn-primary {
      background: #f59e0b;
      color: #111827;
    }

    .btn-outline {
      background: #fff;
      border: 1px solid #d9dee8;
      color: #374151;
    }

    /* ================= CHART ================= */

    .chart {
      height: 260px;
      display: flex;
      align-items: flex-end;
      gap: 16px;
      padding: 15px 10px 35px;
      border-bottom: 1px solid #e5e7eb;
      position: relative;
    }

    .chart::before,
    .chart::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      border-top: 1px dashed #e5e7eb;
    }

    .chart::before {
      top: 65px;
    }

    .chart::after {
      top: 145px;
    }

    .bar-wrap {
      height: 100%;
      flex: 1;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      position: relative;
      z-index: 2;
    }

    .bar {
      width: 34px;
      border-radius: 6px 6px 0 0;
      background: #f59e0b;
      min-height: 12px;
      transition: .3s;
    }

    .bar:hover {
      background: #d97706;
      transform: translateY(-3px);
    }

    .bar-label {
      position: absolute;
      bottom: -28px;
      font-size: 11px;
      color: #737b8c;
    }

    /* ================= BREAKDOWN ================= */

    .earning-row {
      margin-bottom: 20px;
    }

    .earning-top {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 13px;
    }

    .progress {
      height: 8px;
      border-radius: 20px;
      background: #eef1f5;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      background: #f59e0b;
      border-radius: 20px;
    }

    .balance {
      background: #111827;
      color: #fff;
      border-radius: 14px;
      padding: 24px;
      margin-bottom: 20px;
    }

    .balance-label {
      color: #aeb6c5;
      font-size: 13px;
    }

    .balance-value {
      font-size: 31px;
      font-weight: 800;
      margin: 8px 0 18px;
    }

    .balance-actions {
      display: flex;
      gap: 10px;
    }

    /* ================= FILTERS ================= */

    .filters {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .search {
      flex: 1;
      min-width: 220px;
      position: relative;
    }

    .search input {
      width: 100%;
      border: 1px solid #dfe3ea;
      border-radius: 9px;
      padding: 11px 13px;
      outline: none;
    }

    .filter-select {
      border: 1px solid #dfe3ea;
      border-radius: 9px;
      background: #fff;
      padding: 10px 12px;
      min-width: 150px;
      outline: none;
    }

    /* ================= TABLE ================= */

    .table-card {
      background: #fff;
      border: 1px solid #e7eaf0;
      border-radius: 14px;
      overflow: hidden;
    }

    .table-header {
      padding: 20px 22px;
      border-bottom: 1px solid #edf0f4;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .table-title {
      font-size: 17px;
      font-weight: 750;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 850px;
    }

    th {
      background: #f8fafc;
      text-align: left;
      padding: 13px 18px;
      font-size: 12px;
      color: #6b7280;
      font-weight: 700;
    }

    td {
      padding: 15px 18px;
      border-top: 1px solid #edf0f4;
      font-size: 13px;
    }

    .transaction {
      font-weight: 700;
    }

    .muted {
      color: #7a8394;
      font-size: 12px;
      margin-top: 3px;
    }

    .amount {
      font-weight: 750;
    }

    .amount.credit {
      color: #16a34a;
    }

    .amount.debit {
      color: #dc2626;
    }

    .status {
      display: inline-flex;
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }

    .status.completed {
      background: #dcfce7;
      color: #15803d;
    }

    .status.pending {
      background: #fef3c7;
      color: #b45309;
    }

    .status.processing {
      background: #dbeafe;
      color: #1d4ed8;
    }

    /* ================= EMPTY ================= */

    .empty {
      text-align: center;
      padding: 35px;
      color: #737b8c;
      display: none;
    }

    /* ================= RESPONSIVE ================= */

    @media(max-width:1100px) {
      .stats {
        grid-template-columns: repeat(2,1fr);
      }

      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media(max-width:800px) {
      .sidebar {
        width: 70px;
        padding: 15px 8px;
      }

      .logo {
        font-size: 0;
        text-align: center;
        padding: 10px 0 20px;
      }

      .logo::after {
        content: "B";
        font-size: 25px;
        color: #f59e0b;
      }

      .nav-title,
      .nav-item span:not(.nav-icon),
      .profile-info {
        display: none;
      }

      .nav-item {
        justify-content: center;
        padding: 12px 5px;
      }

      .main {
        margin-left: 70px;
      }

      .content {
        padding: 18px;
      }

      .topbar {
        padding: 0 18px;
      }
    }

    @media(max-width:600px) {
      .stats {
        grid-template-columns: 1fr;
      }

      .chart {
        gap: 5px;
      }

      .bar {
        width: 20px;
      }

      .page-title {
        font-size: 17px;
      }
    }
  </style>
</head>

