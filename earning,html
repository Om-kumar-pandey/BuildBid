      =====================================================

      GET  /api/earnings
        -> earnings summary + monthly chart data

      GET  /api/earnings/transactions
        -> transaction history

      GET  /api/earnings/statement
        -> download statement

      POST /api/earnings/withdraw
        -> withdrawal request

      GET  /api/bank-account
        -> contractor bank account

      PUT /api/bank-account
        -> update bank account

      Authentication:
        Authorization: Bearer <JWT>

      Recommended:
        Load all earnings data from API after login.
    */


    function filterTransactions() {

      const search =
        document
          .getElementById("searchTransaction")
          .value
          .toLowerCase();

      const status =
        document
          .getElementById("statusFilter")
          .value;

      const type =
        document
          .getElementById("typeFilter")
          .value;

      const rows =
        document.querySelectorAll(".transaction-row");

      let visible = 0;

      rows.forEach(row => {

        const text =
          row.innerText.toLowerCase();

        const rowStatus =
          row.dataset.status;

        const rowType =
          row.dataset.type;

        const searchMatch =
          text.includes(search);

        const statusMatch =
          status === "all" ||
          rowStatus === status;

        const typeMatch =
          type === "all" ||
          rowType === type;

        if (
          searchMatch &&
          statusMatch &&
          typeMatch
        ) {

          row.style.display = "";
          visible++;

        } else {

          row.style.display = "none";

        }

      });


      document.getElementById("emptyState")
        .style.display =
          visible === 0
            ? "block"
            : "none";
    }


